*.py[cod]
*$py.class
*.so
.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/

# Exception: Include frontend source lib folder (utility functions)
!frontend/src/lib/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.venv
venv
ENV
pip-log.txt
pip-delete-this-directory.txt

# Data
# Note: royalguard.db is EXPLICITLY NOT ignored here 
# because the user wants the demo data to persist on GitHub.
# backend/data/streaming_logs.csv (Optional: keep if small)

# IDE / System
.vscode/
.idea/
.DS_Store
Thumbs.db
